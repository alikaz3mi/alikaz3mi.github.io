source "https://rubygems.org"

# Mirrors the exact Jekyll + plugin versions GitHub Pages builds with, so a local
# `bundle exec jekyll serve` matches production. See:
# https://pages.github.com/versions/
gem "github-pages", group: :jekyll_plugins

# Faster file watching for `jekyll serve` on some platforms (Windows/WSL).
gem "wdm", "~> 0.1", platforms: [:mingw, :x64_mingw, :mswin]

# Ruby 3.4+ no longer bundles these as default gems; harmless to keep on 3.2.
gem "webrick", "~> 1.8"
